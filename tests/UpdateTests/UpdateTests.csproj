<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for src/Update (docs/plugin-auto-update.md §5). No Revit references: the Update
       sources are linked in directly, together with the two pure-.NET helpers they depend on. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RevitMCPBridge.UpdateTests</RootNamespace>
    <AssemblyName>UpdateTests</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);UPDATE_TESTS</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Update\*.cs" Link="Update\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AgentFramework\TelemetryService.cs" Link="AgentFramework\TelemetryService.cs" />
    <Compile Include="..\..\src\AgentFramework\ApiRetry.cs" Link="AgentFramework\ApiRetry.cs" />
    <!-- Knowledge-from-API + request identity (plugin exposure audit, Nov 2026): pure .NET -->
    <Compile Include="..\..\src\AgentFramework\PluginIdentity.cs" Link="AgentFramework\PluginIdentity.cs" />
    <Compile Include="..\..\src\AgentFramework\KnowledgeStore.cs" Link="AgentFramework\KnowledgeStore.cs" />
    <Compile Include="..\..\src\AgentFramework\ProtectedSecret.cs" Link="AgentFramework\ProtectedSecret.cs" />
    <!-- Support agent (docs/support-agent.md §3.3): pure .NET, same linked-source approach -->
    <Compile Include="..\..\src\Support\*.cs" Link="Support\%(Filename)%(Extension)" />
    <!-- Voice (push-to-talk): the pure parts; VoiceTranscriber/VoiceRecorder need the native runtime and a mic -->
    <Compile Include="..\..\src\Voice\VoiceAudio.cs" Link="Voice\VoiceAudio.cs" />
    <Compile Include="..\..\src\Voice\VoiceModelStore.cs" Link="Voice\VoiceModelStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
  </ItemGroup>

</Project>
